name: CI

on:
  push:
    branches: [main, develop]
  pull_request:
    branches: [main, develop]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3

      - name: Set up Go
        uses: actions/setup-go@v4
        with:
          go-version: '1.21'

      - name: Build
        run: go build -v ./...

      - name: Test
        run: go test -v -race -coverprofile=coverage.out ./...

      - name: Upload coverage
        uses: codecov/codecov-action@v3
        with:
          files: ./coverage.out

      - name: Build Docker image
        run: |
          podman build -t ocir.io/tenancy-namespace/taskmanager-backend:${{ github.sha }} ./backend

      - name: Push to OCI Registry
        run: |
          echo ${{ secrets.OCI_AUTH_TOKEN }} | podman login ocir.io -u tenancy-namespace --password-stdin
          podman push ocir.io/tenancy-namespace/taskmanager-backend:${{ github.sha }}
