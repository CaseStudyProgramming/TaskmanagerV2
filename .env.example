# Environment Variables Template
# Copy this file to .env.development and .env.production
# Fill in actual values (DO NOT commit .env files to Git)

# Neon Database
NEON_API_KEY=your-neon-api-key
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Forgejo CI/CD
FORGEJO_URL=https://ci.davidcps.my.id
FORGEJO_TOKEN=your-forgejo-token
FORGEJO_ADMIN_PASSWORD=your-admin-password

# Vercel Webhook Handler
VERCEL_FORGEJO_TOKEN=your-forgejo-token
VERCEL_WEBHOOK_SECRET=your-webhook-secret

# OCI (Oracle Cloud Infrastructure)
OCI_API_KEY=your-oci-api-key
OCI_PRIVATE_KEY_PATH=/home/davidtan/.oci/oci_api_private_key.pem
OCI_CONFIG_PATH=/home/davidtan/.oci/config
OCI_INSTANCE_IP=your-oci-instance-ip

# Cloudflare
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ZONE_ID=your-zone-id
CLOUDFLARE_ACCOUNT_ID=your-account-id

# GitHub
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Application
NODE_ENV=development
PORT=3000
