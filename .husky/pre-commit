#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# Frontend checks
if [ -d "frontend" ]; then
  echo "📦 Frontend checks..."
  cd frontend
  if [ -f "package.json" ]; then
    bun run format:check
    bun run lint
    bun run type-check
    bun run test:unit
  fi
  cd ..
fi

# Backend checks
if [ -d "backend" ]; then
  echo "🔧 Backend checks..."
  cd backend
  if [ -f "go.mod" ]; then
    gofmt -l . | exit $(wc -l)
    golangci-lint run
    go vet ./...
    go test ./... -short
  fi
  cd ..
fi

echo "✅ All pre-commit checks passed!"