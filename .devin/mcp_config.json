{
  "mcpServers": {
    "aiven": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.aiven.live/mcp"
      ],
      "env": {
        "AIVEN_API_KEY": "${AIVEN_API_KEY:-}"
      }
    },
    "neon": {
      "url": "https://mcp.neon.tech/mcp",
      "transport": "http",
      "env": {
        "NEON_API_KEY": "${NEON_API_KEY:-}"
      }
    }
  }
}
